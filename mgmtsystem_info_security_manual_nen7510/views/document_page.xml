<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record model="ir.ui.view" id="view_wiki_form">
      <field name="name">document.page.form</field>
      <field name="model">document.page</field>
      <field name="inherit_id" ref="document_page.view_wiki_form"/>
      <field name="arch" type="xml">
          <xpath expr="//page[@name='history']" position="before">
              <page name="nen_7510" string="NEN 7510">
                  <group>
                      <group>
                          <field name="nen_chapter"/>
                          <field name="nen_control"/>
                          <field name="internal_reference"/>
                      </group>
                      <group>
                          <field name="nen_mandatory" widget="boolean_toggle"/>
                          <field name="external_reference"/>
                      </group>
                  </group>
              </page>
          </xpath>
      </field>
  </record>

  <record model="ir.ui.view" id="view_wiki_menu_form">
      <field name="name">document.page.menu.form</field>
      <field name="model">document.page</field>
      <field name="inherit_id" ref="document_page.view_wiki_menu_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='content']" position="before">
              <group>
                  <group>
                      <field name="nen_chapter" readonly="1"/>
                      <field name="nen_control" readonly="1"/>
                      <field name="internal_reference" readonly="1"/>
                  </group>
                  <group>
                      <field name="nen_mandatory" readonly="1"/>
                      <field name="external_reference" readonly="1"/>
                  </group>
              </group>
          </xpath>
      </field>
  </record>

  <record model="ir.ui.view" id="view_wiki_tree">
      <field name="name">view_wiki_tree</field>
      <field name="model">document.page</field>
      <field name="inherit_id" ref="document_page.view_wiki_tree"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='parent_id']" position="replace">
              <field name="parent_id" optional="hide"/>
              <field name="nen_chapter" optional="show"/>
              <field name="nen_control" optional="hide"/>
          </xpath>
      </field>
  </record>

  <record model="ir.ui.view" id="view_wiki_filter">
      <field name="name">document.page.search</field>
      <field name="model">document.page</field>
      <field name="inherit_id" ref="document_page.view_wiki_filter"/>
      <field name="arch" type="xml">
          <xpath expr="//searchpanel" position="inside">
              <field name="nen_chapter" icon="fa-shield" string="Chapter" enable_counters="1"/>
          </xpath>
      </field>
  </record>
</odoo>
