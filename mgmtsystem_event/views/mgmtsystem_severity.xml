<odoo>
    <!-- Severity -->
    <record id="view_mgmtsystem_event_severity_form" model="ir.ui.view">
        <field name="name">mgmtsystem.event.severity.form</field>
        <field name="type">form</field>
        <field name="model">mgmtsystem.event.severity</field>
        <field name="arch" type="xml">
            <form string="Severity of Complaints and Events">
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="description" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="open_mgmtsystem_event_severity_list" model="ir.actions.act_window">
        <field name="name">Severity</field>
        <field name="res_model">mgmtsystem.event.severity</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_open_event_severity"
        action="open_mgmtsystem_event_severity_list"
        parent="mgmtsystem_event.menu_mgmtsystem_configuration_events"
        groups="mgmtsystem.group_mgmtsystem_manager"
    />
</odoo>
