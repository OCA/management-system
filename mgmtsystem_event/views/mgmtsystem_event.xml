<odoo>
    <menuitem
        id="menu_mgmtsystem_configuration_events"
        name="Events"
        parent="mgmtsystem.menu_mgmtsystem_configuration"
        groups="mgmtsystem.group_mgmtsystem_manager"
        sequence="10"
    />

    <record id="view_mgmtsystem_event_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.event.list</field>
        <field name="model">mgmtsystem.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref" readonly="True" />
                <field name="create_date" />
                <field name="opened_date" optional="show" />
                <field name="closed_date" optional="hide" />
                <field
                    name="deadline_date"
                    decoration-info="deadline_date &gt; context_today().strftime('%Y-%m-%d')"
                    decoration-warning="deadline_date == context_today().strftime('%Y-%m-%d')"
                    decoration-danger="deadline_date &lt; context_today().strftime('%Y-%m-%d')"
                />
                <field name="partner_id" optional="hide" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="name" />
                <field name="user_id" optional="show" />
                <field name="responsible_user_id" optional="show" />
                <field name="manager_user_id" optional="hide" />
                <field name="system_id" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="stage_id" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_event_filter" model="ir.ui.view">
        <field name="name">mgmtsystem.event.filter</field>
        <field name="model">mgmtsystem.event</field>
        <field name="arch" type="xml">
            <search>
                <group name="filters">
                    <filter
                        name="draft"
                        domain="[('state','=','draft')]"
                        string="Draft"
                        help="Draft/New events"
                    />
                    <filter
                        name="pending"
                        domain="[('state','in',['analysis','pending'])]"
                        string="Analysis"
                        help="Events pending review"
                    />
                    <filter
                        name="current"
                        domain="[('state','=','open')]"
                        string="In Progress"
                        help="Open Events"
                    />
                    <filter
                        name="icon"
                        domain="[('state','=','done')]"
                        string="Closed"
                        help="Closed Events"
                    />
                    <separator orientation="vertical" />
                    <field name="ref" />
                    <field name="tag_ids" />
                    <field name="create_date" />
                    <filter
                        name="current_user"
                        string="User"
                        domain="['|','|',('user_id','=',uid),('responsible_user_id','=',uid),('manager_user_id','=',uid)]"
                    />
                    <field name="system_id" />
                    <field name="company_id" groups="base.group_multi_company" />
                </group>
                <newline />
                <group expand="0" string="Group By...">
                    <filter
                        name="groupby_author"
                        string="Author"
                        context="{'group_by':'user_id'}"
                    />
                    <filter
                        name="groupby_responsible"
                        string="Responsible"
                        context="{'group_by':'responsible_user_id'}"
                    />
                    <filter
                        name="groupby_manager"
                        string="Manager"
                        context="{'group_by':'manager_user_id'}"
                    />
                    <separator orientation="vertical" />
                    <filter
                        name="groupby_system"
                        string="System"
                        context="{'group_by':'system_id'}"
                    />
                    <filter
                        name="groupby_partner"
                        string="Partner"
                        domain="[]"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        name="groupby_procedure"
                        string="Procedure"
                        context="{'group_by':'procedure_ids'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_mgmtsystem_event_kanban" model="ir.ui.view">
        <field name="name">mgmtsystem.event.kanban</field>
        <field name="model">mgmtsystem.event</field>
        <field name="arch" type="xml">
            <kanban
                quick_create="false"
                default_group_by="stage_id"
                class="o_kanban_small_column"
            >
                <field name="stage_id" />
                <field name="responsible_user_id" />
                <field name="ref" />
                <field name="name" />
                <field name="message_needaction_counter" />
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="d-flex justify-content-between">
                                <strong>
                                    <field name="ref" />
                                    -
                                    <field name="name" />
                                </strong>
                                <field name="kanban_state" widget="state_selection" />
                            </div>
                            <div class="d-flex">
                                <field
                                    name="tag_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                                />
                            </div>
                            <div class="d-flex justify-content-between">
                                <span title='Unread Messages'>
                                    <i class='fa fa-comments' />
                                    <t
                                        t-esc="record.message_needaction_counter.raw_value"
                                    />
                                </span>
                                <field
                                    name="responsible_user_id"
                                    widget="many2one_avatar_user"
                                />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_mgmtsystem_event_form" model="ir.ui.view">
        <field name="name">mgmtsystem.event.form</field>
        <field name="model">mgmtsystem.event</field>
        <field name="arch" type="xml">
            <form string="Event">
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': 1}"
                    />
                </header>
                <sheet string="Event">
                    <div class="oe_button_box" name="button_box" />
                    <field name="kanban_state" widget="state_selection" />
                    <div class="oe_title">
                        <h1>
                            <field name="ref" readonly="1" />
                        </h1>
                    </div>
                    <group name="main">
                        <group name="config">
                            <field name="name" readonly="state not in 'draft'" />
                            <field name="reference" readonly="state not in 'draft'" />
                            <field name="res_ref" readonly="state not in 'draft'" />
                            <field
                                name="partner_id"
                                readonly="state not in ('draft', 'analysis')"
                            />
                        </group>
                        <group name="meta">
                            <field name="create_date" readonly="1" />
                            <field name="user_id" readonly="1" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                placeholder="Add a description ..."
                                readonly="state not in ('draft', 'analysis')"
                            />
                        </page>

                        <page string="Triage" name="triage">
                            <group>
                                <group>
                                    <field
                                        name="origin_ids"
                                        widget="many2many_tags"
                                        readonly="state not in ('draft', 'analysis')"
                                    />
                                    <field name="event_type" />
                                    <field
                                        name="system_id"
                                        readonly="state not in ('draft', 'analysis')"
                                    />
                                    <field
                                        name="immediate_action_id"
                                        domain="[('type_action','=','immediate')]"
                                        readonly="state not in ('draft', 'analysis')"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="deadline_date"
                                        decoration-info="deadline_date &gt; context_today().strftime('%Y-%m-%d')"
                                        decoration-warning="deadline_date == context_today().strftime('%Y-%m-%d')"
                                        decoration-danger="deadline_date &lt; context_today().strftime('%Y-%m-%d')"
                                    />
                                    <field name="opened_date" />
                                    <field name="closed_date" />
                                    <field
                                        name="responsible_user_id"
                                        readonly="state not in ('draft', 'analysis')"
                                    />
                                    <field
                                        name="manager_user_id"
                                        readonly="state not in ('draft', 'analysis')"
                                    />
                                </group>
                            </group>
                        </page>

                        <page
                            string="Procedures"
                            readonly="state == 'draft'"
                            name="procedures"
                        >
                            <div
                                invisible="state != 'draft'"
                                class="alert alert-warning"
                                role="status"
                            >
                                <p
                                >You cannot edit this page if the event is in Draft state</p>
                            </div>
                            <field
                                name="procedure_ids"
                                readonly="state not in ('draft', 'analysis')"
                                domain="[('parent_id','child_of',('Procedure','Environmental Aspect','Manuals'))]"
                            />
                        </page>

                        <page
                            string="Causes and Analysis"
                            readonly="state in ('draft', 'cancel')"
                            name="causes_analysis"
                        >
                            <div
                                invisible="state not in ('draft', 'cancel')"
                                class="alert alert-warning"
                                role="status"
                            >
                                <p
                                >You cannot edit this page if the event is in Draft or Cancel state</p>
                            </div>

                            <separator string="Analysis" />
                            <field name="analysis" readonly="state not in 'analysis'" />

                            <separator string="Causes" />
                            <field
                                name="cause_ids"
                                readonly="state not in 'analysis'"
                                options="{'no_create': True}"
                            >
                                <list create="1" delete="1" decoration-info="parent_id">
                                    <field name="parent_id" />
                                    <field name="name" />
                                    <field name="description" />
                                    <field name="sequence" />
                                </list>
                            </field>

                            <separator string="Analysis Confirmation" />
                            <group>
                                <group>
                                    <field
                                        name="severity_id"
                                        readonly="state not in 'analysis'"
                                    />
                                </group>
                            </group>
                        </page>

                        <page
                            string="Actions"
                            readonly="state in ('draft', 'analysis', 'cancel')"
                            name="actions"
                        >
                            <div
                                invisible="state not in ('draft', 'analysis', 'cancel')"
                                class="alert alert-warning"
                                role="status"
                            >
                                <p
                                >You cannot edit this page if the event is in Draft, Analysis or Cancel state</p>
                            </div>

                            <separator string="Action Plan" />
                            <field
                                name="action_ids"
                                readonly="state not in 'pending'"
                            />

                            <group string="Plan Review" name="plan_review">
                                <field
                                    name="action_comments"
                                    readonly="state not in 'pending'"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Action Plan Comments"
                                />
                            </group>

                            <group
                                name="effectiveness_review"
                                invisible="state not in 'open' and state not in 'done'"
                                string="Effectiveness Review"
                            >
                                <field
                                    name="evaluation_comments"
                                    readonly="state not in 'open'"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Evaluation Comments"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="open_mgmtsystem_event_list">
        <field name="name">Events</field>
        <field name="res_model">mgmtsystem.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_mgmtsystem_event_kanban" />
        <field name="search_view_id" ref="view_mgmtsystem_event_filter" />
        <field name="context">{"search_default_user_id":uid}</field>
    </record>

    <record model="ir.actions.act_window" id="open_mgmtsystem_event_thread_list">
        <field name="name">Events</field>
        <field name="res_model">mgmtsystem.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('res_id', '=', id), ('res_model', '=', mgmtsystem_event)]
        </field>
        <field name="view_id" ref="view_mgmtsystem_event_kanban" />
        <field name="search_view_id" ref="view_mgmtsystem_event_filter" />
        <field
            name="context"
        >{"search_default_user_id":uid, "default_res_model": mgmtsystem_event, "default_res_id": id}
        </field>
    </record>

    <menuitem
        id="menu_open_event"
        name="Events"
        action="open_mgmtsystem_event_list"
        parent="mgmtsystem.menu_mgmtsystem_main"
        sequence="30"
        groups="mgmtsystem.group_mgmtsystem_manager,mgmtsystem.group_mgmtsystem_auditor,base.group_user"
    />
</odoo>
