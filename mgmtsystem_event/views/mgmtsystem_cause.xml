<odoo>
    <!-- Cause -->

    <record id="view_mgmtsystem_event_cause_form" model="ir.ui.view">
        <field name="name">mgmtsystem.event.cause.form</field>
        <field name="type">form</field>
        <field name="model">mgmtsystem.event.cause</field>
        <field name="arch" type="xml">
            <form string="Causes of event">
                <group>
                    <field name="name" />
                    <field name="sequence" />
                    <field name="parent_id" />
                    <field name="ref_code" />
                    <field name="description" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_mgmtsystem_event_cause_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.event.cause.list</field>
        <field name="model">mgmtsystem.event.cause</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="parent_id" />
                <field name="name" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_event_cause_filter" model="ir.ui.view">
        <field name="name">Causes</field>
        <field name="model">mgmtsystem.event.cause</field>
        <field name="arch" type="xml">
            <search string="Causes">
                <field name="parent_id" />
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="open_mgmtsystem_event_cause_list" model="ir.actions.act_window">
        <field name="name">Causes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mgmtsystem.event.cause</field>
        <field name="view_id" eval="view_mgmtsystem_event_cause_tree" />
        <field name="search_view_id" ref="view_mgmtsystem_event_cause_filter" />
    </record>

    <menuitem
        id="menu_open_event_cause"
        action="open_mgmtsystem_event_cause_list"
        parent="menu_mgmtsystem_configuration_events"
        sequence="30"
        groups="mgmtsystem.group_mgmtsystem_manager"
    />
</odoo>
