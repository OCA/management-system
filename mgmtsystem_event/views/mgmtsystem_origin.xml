<odoo>
    <!-- Origin -->

    <record id="view_mgmtsystem_event_origin_form" model="ir.ui.view">
        <field name="name">mgmtsystem.event.origin.form</field>
        <field name="type">form</field>
        <field name="model">mgmtsystem.event.origin</field>
        <field name="arch" type="xml">
            <form string="Origins of event">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="parent_id" />
                        <field name="ref_code" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgmtsystem_event_origin_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.event.origin.list</field>
        <field name="model">mgmtsystem.event.origin</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="parent_id" />
                <field name="name" />
                <field name="description" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_event_origin_filter" model="ir.ui.view">
        <field name="name">Origins</field>
        <field name="model">mgmtsystem.event.origin</field>
        <field name="arch" type="xml">
            <search string="Origins">
                <field name="parent_id" />
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="open_mgmtsystem_event_origin_list" model="ir.actions.act_window">
        <field name="name">Origins</field>
        <field name="res_model">mgmtsystem.event.origin</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False" />
        <field name="search_view_id" ref="view_mgmtsystem_event_origin_filter" />
    </record>

    <menuitem
        id="menu_open_event_origin"
        action="open_mgmtsystem_event_origin_list"
        parent="menu_mgmtsystem_configuration_events"
        sequence="20"
        groups="mgmtsystem.group_mgmtsystem_manager"
    />
</odoo>
