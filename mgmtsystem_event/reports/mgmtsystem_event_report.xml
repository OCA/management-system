<odoo>
    <!-- Management System Event Report Pivot View -->
    <record id="view_report_mgmtsystem_event_pivot" model="ir.ui.view">
        <field name="name">mgmtsystem.event.report.pivot</field>
        <field name="model">mgmtsystem.event</field>
        <field name="arch" type="xml">
            <pivot string="Event" disable_linking="True">
                <field name="state" type="row" />
                <field name="user_id" type="col" />
                <field name="number_of_events" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Event Report Graph View -->
    <record id="view_report_mgmtsystem_event_graph" model="ir.ui.view">
        <field name="name">mgmtsystem.event.report.graph</field>
        <field name="model">mgmtsystem.event</field>
        <field name="arch" type="xml">
            <graph string="Event">
                <field name="state" />
                <field name="user_id" />
                <field name="number_of_events" type="measure" />
            </graph>
        </field>
    </record>

    <!-- Management system Event Report Action -->
    <record id="action_report_mgmtsystem_event" model="ir.actions.act_window">
        <field name="name">Management System Analysis</field>
        <field name="res_model">mgmtsystem.event</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_id" />
        <!-- force empty -->
        <field
            name="help"
        >Have a general overview of all events processed in the system by sorting them with specific criteria.</field>
    </record>

    <menuitem
        name="Events"
        id="menu_report_mgmtsystem_event_tree"
        action="action_report_mgmtsystem_event"
        parent="mgmtsystem.menu_mgmtsystem_report"
        sequence="15"
    />
</odoo>
