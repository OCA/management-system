<templates xml:space="preserve">

    <t
        t-name="mgmtsystem_nonconformity.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="before">
            <button
                class="o_ChatterTopbar_button o_ChatterTopbar_buttonNonConformities btn btn-link"
                type="button"
                t-att-disabled="this.threadId() and !this.thread().hasWriteAccess"
                t-on-click="this.onClickShowNonConformities"
                t-if="this.thread().non_conformity_count !== undefined"
            >
                <i
                    class="fa fa-exclamation-triangle fa-lg me-1"
                    role="img"
                    aria-label="Non conformities"
                />
                <sup
                    class="o_ChatterTopbar_buttonCount o_ChatterTopbar_buttonNonConformitiesCount"
                    t-out="this.thread().non_conformity_count"
                />
            </button>
        </xpath>
    </t>
</templates>
