<odoo>
    <record model="ir.ui.view" id="mgmtsystem_document_form_view">
        <field name="model">mgmtsystem.document</field>
        <field name="arch" type="xml">
            <form create="0">
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="document_type" />
                        <field name="kind" />
                        <field name="link" invisible="document_type != 'link'" />
                        <field name="system_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="mgmtsystem_document_form_new_view">
        <field name="name">mgmtsystem.document.form.new</field>
        <field name="model">mgmtsystem.document</field>
        <field name="inherit_id" ref="mgmtsystem.mgmtsystem_document_form_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <sheet position="after">
                <footer>
                    <button
                        string="Save"
                        type="object"
                        name="action_create"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </sheet>
        </field>
    </record>

    <record model="ir.ui.view" id="mgmtsystem_document_search_view">
        <field name="model">mgmtsystem.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="mgmtsystem_document_tree_view">
        <field name="model">mgmtsystem.document</field>
        <field name="arch" type="xml">
            <list js_class="mgmtsystem_document" create="0">
                <field name="name" />
                <field name="document_type" />
                <field name="system_id" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="mgmtsystem_document_act_window">
        <field name="name">Documents</field>
        <field name="res_model">mgmtsystem.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="path">mgmtsystem-documents</field>
    </record>

    <record model="ir.actions.act_window" id="mgmtsystem_document_act_window_new">
        <field name="name">Documents</field>
        <field name="res_model">mgmtsystem.document</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="view_id" ref="mgmtsystem_document_form_new_view" />
    </record>

    <record model="ir.ui.menu" id="mgmtsystem_document_menu">
        <field name="name">Documents</field>
        <field name="parent_id" ref="menu_mgmtsystem_manuals" />
        <field name="action" ref="mgmtsystem_document_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
