#. module: mgmtsystem_audit
#: model:mail.template,body_html:mgmtsystem_audit.template_email_send_verification_list
msgid ""
"<p>Hello,</p>\n"
"\n"
"<p>\n"
"The audit <t t-out=\"object.name\"/> is scheduled in 1 week.\n"
"Please finish the verification list and send it to the auditees:\n"
"\n"
"<a t-att-href=\"object.get_action_url()\">Link</a>\n"
"</p>\n"
"\n"
"<p>\n"
"Thank you.<span data-o-mail-quote=\"1\">\n"
"--\n"
"Odoo\n"
"</span></p>\n"
"            \n"
"        "
msgstr ""
"<p>Merhaba,</p>\n"
"\n"
"<p>\n"
"<t t-out=\"object.name\"/> denetimi 1 hafta sonra yapılacaktır.\n"
"Lütfen kontrol listesini tamamlayıp denetlenenlere gönderin:\n"
"\n"
"<a t-att-href=\"object.get_action_url()\">Bağlantı</a>\n"
"</p>\n"
"\n"
"<p>\n"
"Teşekkürler.<span data-o-mail-quote=\"1\">\n"
"--\n"
"Odoo\n"
"</span></p>\n"
"            \n"
"        "

#. module: mgmtsystem_audit
#: model:mail.template,body_html:mgmtsystem_audit.template_email_prepare_to_audit
msgid ""
"<p>Hello,</p>\n"
"\n"
"<p>\n"
"The audit <t t-out=\"object.name\"/> is scheduled in 2 weeks.\n"
"Please prepare the verification list:\n"
"\n"
"<a t-att-href=\"object.get_action_url()\">Link</a>\n"
"</p>\n"
"\n"
"<p>\n"
"Thank you.<span data-o-mail-quote=\"1\">\n"
"--\n"
"Odoo\n"
"</span></p>\n"
"            \n"
"        "
msgstr ""
"<p>Merhaba,</p>\n"
"\n"
"<p>\n"
"<t t-out=\"object.name\"/> denetimi 2 hafta sonra yapılacaktır.\n"
"Lütfen kontrol listesini hazırlayın:\n"
"\n"
"<a t-att-href=\"object.get_action_url()\">Bağlantı</a>\n"
"</p>\n"
"\n"
"<p>\n"
"Teşekkürler.<span data-o-mail-quote=\"1\">\n"
"--\n"
"Odoo\n"
"</span></p>\n"
"            \n"
"        "

