<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_mgmtsystem_audit_tag_search" model="ir.ui.view">
        <field name="name">mgmtsystem.audit.tag.search</field>
        <field name="model">mgmtsystem.audit.tag</field>
        <field name="arch" type="xml">
            <search string="Audit tag search">
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
                <separator />
                <field name="name" filter_domain="[('name', 'ilike', self)]" />
            </search>
        </field>
    </record>

    <record id="view_mgmtsystem_audit_tag_form" model="ir.ui.view">
        <field name="name">mgmtsystem.audit.tag.form</field>
        <field name="model">mgmtsystem.audit.tag</field>
        <field name="arch" type="xml">
            <form string="Audit tag">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="active" invisible="1" />
                    </group>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group name="main">
                        <field name="color" widget="color_picker" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgmtsystem_audit_tag_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.audit.tag.tree</field>
        <field name="model">mgmtsystem.audit.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="color" widget="color_picker" string="Color" />
            </tree>
        </field>
    </record>

    <record id="action_mgmtsystem_audit_tag" model="ir.actions.act_window">
        <field name="name">Audit tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mgmtsystem.audit.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_mgmtsystem_audit_tag"
        name="Audit tags"
        parent="mgmtsystem.menu_mgmtsystem_configuration"
        action="action_mgmtsystem_audit_tag"
        sequence="45"
    />

</odoo>
