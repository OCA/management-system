<?xml version="1.0" encoding="utf-8" ?>
<!-- noupdate="0" para forzar la corrección de plantillas migradas incorrectamente desde Odoo 14 -->
<odoo noupdate="0">

    <!-- Corrige email_from en: Action Assigned -->
    <record id="mgmtsystem_action.email_template_new_action_reminder" model="mail.template">
        <field name="email_from">{{object.create_uid.company_id.email or 'noreply@localhost'}}</field>
        <field name="lang">{{object.create_uid.partner_id.lang}}</field>
    </record>

    <!-- Corrige email_from en: Reminder to Responsible (action) -->
    <record id="mgmtsystem_action.action_email_template_reminder_action" model="mail.template">
        <field name="email_from">{{object.create_uid.company_id.email or 'noreply@localhost'}}</field>
        <field name="lang">{{object.create_uid.partner_id.lang}}</field>
    </record>

    <!-- Corrige email_from en: Reminder to Responsible (claim) -->
    <record id="mgmtsystem_claim.email_template_new_claim_reminder" model="mail.template">
        <field name="email_from">{{object.create_uid.company_id.email or 'noreply@localhost'}}</field>
        <field name="lang">{{object.create_uid.partner_id.lang}}</field>
    </record>

    <!-- Corrige email_from en: Reminder to Responsible (claim remain) -->
    <record id="mgmtsystem_claim.email_template_remain_claim_reminder" model="mail.template">
        <field name="email_from">{{object.create_uid.company_id.email or 'noreply@localhost'}}</field>
        <field name="lang">{{object.create_uid.partner_id.lang}}</field>
    </record>

</odoo>

